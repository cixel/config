# Rex (superlogical.com/rex) terminal multiplexer config.
#
# Rex reads ~/.config/rex/init.lua (Lua). Keybindings are ported from
# tmux.nix. Colors come from ghostty.nix: Rex can't set colors from Lua, but
# its client can import a Ghostty theme file, so we render one from the same
# palette Ghostty uses and import it once (see init.lua `import_theme`).
#
# After `hms`, run `rex config reload` (Rex doesn't watch the file).
{ config, lib, pkgs, ... }:
let
  # Rex prepends its bin dir to PATH (and sets REX_BIN_DIR) in terminals it
  # spawns, but nix-darwin's set-environment (sourced from /etc/zshenv and
  # fish's preinit) rebuilds PATH from scratch and drops it. It's also absent
  # in non-Rex terminals. This wrapper finds the CLI either way, preferring
  # REX_BIN_DIR so the CLI always matches the running server's version.
  rexCli = pkgs.writeShellScriptBin "rex" ''
    for dir in \
      "''${REX_BIN_DIR:-}" \
      "$HOME/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS" \
      "/Applications/Rex Beta.app/Contents/Helpers/Rex Server.rex/Contents/MacOS" \
      "/Applications/Rex.app/Contents/Helpers/Rex Server.rex/Contents/MacOS"
    do
      if [ -n "$dir" ] && [ -x "$dir/rex" ]; then
        exec "$dir/rex" "$@"
      fi
    done
    echo "rex: Rex CLI not found (is Rex installed?)" >&2
    exit 127
  '';

  ghostty = config.programs.ghostty.settings;

  # Base colors from Ghostty's "Gruvbox Dark Hard" theme. ghostty.nix only
  # overrides the 16-color palette, so the rest is copied from the theme.
  base = {
    background = "#1d2021";
    foreground = "#ebdbb2";
    cursor-color = "#ebdbb2";
    cursor-text = "#1d2021";
    selection-background = "#665c54";
    selection-foreground = "#ebdbb2";
  };

  themeFile = pkgs.writeText "gruvbox-dark-hard.ghostty" (lib.concatStringsSep "\n" (
    [ "# Generated by nix/home-manager/rex/default.nix from ghostty.nix" ]
    ++ map (p: "palette = ${p}") ghostty.palette
    ++ lib.mapAttrsToList (k: v: "${k} = ${v}") base
  ) + "\n");
in
lib.mkMerge [
{
  home.packages = lib.optionals pkgs.stdenv.hostPlatform.isDarwin [ rexCli ];

  xdg.configFile."rex/init.lua".source = ./init.lua;
  xdg.configFile."rex/themes/gruvbox-dark-hard.ghostty".source = themeFile;
}

# The agent skill lives in agents/skills/rex/SKILL.md (a copy of the stub
# `rex skill setup` writes) instead of running setup imperatively. Warn, but
# never fail, if the installed Rex now writes a different stub. Rex is
# installed outside nix, so this can only be checked at activation time.
#
# The stub only points at `rex __internal skill`, so the guide itself always
# tracks the installed Rex; this check only catches changes to the pointer.
# Session naming (agents rename the Rex session after their task) is opted
# into, matching `rex skill setup --session-naming`. To opt out, compare
# without that flag and copy the resulting stub (it adds
# `--feature-session-naming=false`).
(lib.mkIf pkgs.stdenv.hostPlatform.isDarwin {
  home.activation.rexSkillDrift = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
    rexTmp=$(mktemp -d)
    if (cd "$rexTmp" && ${lib.getExe rexCli} --autostart=false skill setup --agent pi --project --session-naming) >/dev/null 2>&1; then
      if ! diff -q \
          <(grep -v '^<!--' "$rexTmp/.agents/skills/rex/SKILL.md") \
          <(grep -v '^<!--' ${../agents/skills/rex/SKILL.md}) >/dev/null; then
        warnEcho "Rex's agent skill stub differs from nix/home-manager/agents/skills/rex/SKILL.md. Compare with: cd \$(mktemp -d) && rex skill setup --agent pi --project --session-naming && cat .agents/skills/rex/SKILL.md"
      fi
    else
      verboseEcho "rex skill drift check skipped (Rex CLI unavailable)"
    fi
    rm -rf "$rexTmp"
  '';
})

# App settings (Settings > Terminal) live in macOS defaults, not init.lua.
# Rex otherwise launches the account's login shell (/bin/zsh here), so start
# fish the same way ghostty.nix does. Leave empty to get the login shell.
(lib.mkIf pkgs.stdenv.hostPlatform.isDarwin {
  targets.darwin.defaults."com.superlogical.rex" = {
    "Workspace.terminalStartupCommand" =
      "${lib.getExe config.programs.fish.package} --login --interactive";

    # Match ghostty.nix: no color rewriting, so nvim's truecolor gruvbox
    # renders as-is. Rex's defaults raise contrast, use Display P3, and can
    # snap RGB colors to the theme palette.
    "Workspace.terminalImproveTextContrast" = false; # ghostty minimum-contrast = 1
    "Workspace.terminalUsesDisplayP3" = false; # ghostty window-colorspace = srgb
    "Workspace.terminalUseThemePalette" = false;
    "Workspace.terminalPaddingColor" = "background"; # ghostty window-padding-color
    "Workspace.terminalFontName" = "Hack";
  };
})
]
